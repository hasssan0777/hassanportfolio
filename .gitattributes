# Normalise line endings: LF in the repo, native in the working tree
* text=auto

# Explicit text types
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.svg    text eol=lf

# Binary — never diff or convert
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
